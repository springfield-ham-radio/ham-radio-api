{
  "name": "@springfield/ham-radio-api",
  "version": "18.5.1",
  "author": "Bryan Hunt",
  "license": "MIT",
  "files": [
    "dist/",
    "src/"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/springfield-ham-radio/ham-radio-api.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "commitlint": "commitlint --edit",
    "format": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "release": "semantic-release",
    "prepare": "husky && yarn build"
  },
  "dependencies": {
    "loglayer": "^9.4.0",
    "ts-brand": "^0.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "husky": "9.1.7",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "semantic-release": "26.0.1",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "resolutions": {
    "conventional-changelog-conventionalcommits": "10.4.1",
    "socks": "2.8.11",
    "ip-address": "10.7.6",
    "glob": "14.0.6",
    "picomatch": "2.3.2"
  },
  "release": {
    "branches": [
      "main",
      {
        "name": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  },
  "packageManager": "yarn@4.18.0"
}
